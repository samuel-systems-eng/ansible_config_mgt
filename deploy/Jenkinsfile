pipeline {
    agent any
    
    parameters {
        string(name: 'ARTIFACT_VERSION', defaultValue: '1.0.0', description: 'Incoming immutable application build version string')
    }
    
    stages {
        stage('SCM Infrastructure Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Execute Ansible Playbook Deployment') {
            steps {
                // FIXED QUOTE TYPE: Double quotes expand the dynamic version parameters flawlessly before execution
                sh "ansible-playbook -i inventory/dev.yml playbooks/site.yml --extra-vars 'version=${params.ARTIFACT_VERSION} inventory=dev'"
            }
        }
    }
}
