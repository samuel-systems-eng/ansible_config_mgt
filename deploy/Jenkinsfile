pipeline {
    agent any
    
    parameters {
        string(name: 'ARTIFACT_VERSION', defaultValue: '1.0.0', description: 'Incoming immutable application build version string')
    }
    
    stages {
        stage('SCM Infrastructure Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Execute Ansible Playbook Deployment') {
            steps {
                // FIXED INVENTORY PATH DRIFT: Appended .yml to target your true dev.yml inventory configurations flawlessly!
                sh """
                    export ANSIBLE_ROLES_PATH="${WORKSPACE}/roles"
                    ansible-playbook -i ${WORKSPACE}/inventory/dev.yml playbooks/site.yml --extra-vars "version=${params.ARTIFACT_VERSION}"
                """
            }
        }
    }
}
