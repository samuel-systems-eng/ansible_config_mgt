pipeline {
    agent any

    // This block cleanly implements both the Environment and the Ansible Tags task requirements
    parameters {
        choice(
            name: 'inventory', 
            choices: ['dev', 'sit'], 
            description: 'Select the target deployment environment profile'
        )
        string(
            name: 'ansible_tags', 
            defaultValue: 'webserver', 
            description: 'Specify an Ansible tag to run specific roles or tasks (e.g., webserver)'
        )
    }

    environment {
        ANSIBLE_CONFIG = "${WORKSPACE}/deploy/ansible.cfg"
    }

    stages {
        stage('Initialise Workspace') {
            steps {
                echo "Executing securely on workspace branch: ${env.GIT_BRANCH}"
                echo "Target selection: ${params.inventory} environment using tags: ${params.ansible_tags}"
            }
        }

        stage('Prepare Ansible Configuration') {
            steps {
                echo "Dynamically injecting workspace target into ansible.cfg"
                // Cleans up old configuration path layers dynamically
                sh 'sed -i "s|roles_path = .*|roles_path = ./roles:${WORKSPACE}/roles|g" ${WORKSPACE}/deploy/ansible.cfg'
            }
        }

        stage('Run Ansible playbook') {
            steps {
                echo "Invoking Ansible playbook execution against the ${params.inventory} environment..."
                sshagent(['private-key']) {
                    ansiblePlaybook(
                        become: true,
                        credentialsId: 'private-key',
                        disableHostKeyChecking: true,
                        installation: 'ansible',
                        inventory: "${WORKSPACE}/inventory/${params.inventory}.yml",
                        playbook: "${WORKSPACE}/playbooks/site.yml",
                        // TAGS IMPLEMENTATION BELOW:
                        // Passes your tag parameter directly into the native Ansible plugin wrapper execution
                        tags: "${params.ansible_tags}",
                        extraVars: [
                            ansible_ssh_timeout: 5, 
                            inventory: "${params.inventory}"
                        ]
                    )
                }
            }
        }
    }
    
    post {
        always {
            echo 'Wiping workspace components post-execution...'
            cleanWs(cleanWhenAborted: true, cleanWhenFailure: true, deleteDirs: true)
        }
    }
}
