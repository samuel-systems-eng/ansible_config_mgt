pipeline {
    agent any

    parameters {
        choice(
            name: 'INVENTORY_ENV', 
            choices: ['ci', 'dev', 'sit', 'uat'], 
            description: 'Target deployment profile mapping to inventory directory'
        )
        string(
            name: 'ANSIBLE_TAGS', 
            defaultValue: 'artifactory', 
            description: 'Ansible tags to restrict role execution targets'
        )
        string(
            name: 'PLAYBOOK_PATH', 
            defaultValue: 'playbooks/site.yml', 
            description: 'Relative path to the target Ansible playbook'
        )
        string(
            name: 'CREDENTIALS_ID', 
            defaultValue: 'private-key', 
            description: 'Jenkins Credentials ID for SSH mapping'
        )
    }

    environment {
        ANSIBLE_CONFIG = "${WORKSPACE}/deploy/ansible.cfg"
    }

    stages {
        stage('Initialise Workspace') {
            steps {
                echo "Executing securely on workspace branch: ${env.GIT_BRANCH}"
                echo "CACHE_RESET_VERIFICATION_TIMESTAMP: 2026-09-25"
                script {
                    // Safe programmatic override if Jenkins sets parameter to empty string or null
                    env.ACTUAL_TAG = (params.ANSIBLE_TAGS && params.ANSIBLE_TAGS != "null") ? params.ANSIBLE_TAGS : 'artifactory'
                    env.ACTUAL_ENV = (params.INVENTORY_ENV && params.INVENTORY_ENV != "null") ? params.INVENTORY_ENV : 'ci'
                }
                echo "Target selection: ${env.ACTUAL_ENV} environment using tags: ${env.ACTUAL_TAG}"
            }
        }

        stage('Prepare Ansible Configuration') {
            steps {
                echo "Dynamically injecting workspace target into ansible.cfg"
                sh 'sed -i "s|roles_path = .*|roles_path = ./roles:${WORKSPACE}/roles|g" ${WORKSPACE}/deploy/ansible.cfg'
            }
        }

        stage('Run Ansible playbook') {
            steps {
                echo "Invoking Ansible playbook execution against the ${env.ACTUAL_ENV} environment..."
                sshagent(['private-key']) {
                    ansiblePlaybook(
                        become: true,
                        credentialsId: 'private-key',
                        disableHostKeyChecking: true,
                        installation: 'ansible',
                        inventory: "${WORKSPACE}/inventory/${env.ACTUAL_ENV}.yml",
                        playbook: "${WORKSPACE}/${params.PLAYBOOK_PATH}",
                        tags: "${env.ACTUAL_TAG}",
                        extraVars: [
                            ansible_ssh_timeout: 5,
                            inventory: "${env.ACTUAL_ENV}"
                        ] 
                    )
                }
            }
        }
    }
    
    post {
        always {
            echo 'Wiping workspace components post-execution...'
            cleanWs(cleanWhenAborted: true, cleanWhenFailure: true, deleteDirs: true)
        }
    }
}
