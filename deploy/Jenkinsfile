pipeline {
    agent any
    
    parameters {
        string(name: 'ARTIFACT_VERSION', defaultValue: '1.0.0', description: 'Incoming immutable application build version string')
    }
    
    stages {
        stage('SCM Infrastructure Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Execute Ansible Playbook Deployment') {
            steps {
                // HARDENED SOLUTION: Force-injecting the absolute workspace environment paths 
                // into Ansible's runtime parameters so it resolves inventory and roles perfectly.
                sh """
                    export ANSIBLE_ROLES_PATH="${WORKSPACE}/roles"
                    ansible-playbook -i ${WORKSPACE}/inventory/dev playbooks/site.yml --extra-vars "version=${params.ARTIFACT_VERSION}"
                """
            }
        }
    }
}
