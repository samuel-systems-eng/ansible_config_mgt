pipeline {
    agent any

    // Your brilliant String Parameter strategy to force absolute execution control
    parameters {
        choice(
            name: 'inventory', 
            choices: ['dev', 'sit', 'uat'], 
            description: 'Select the target deployment environment profile'
        )
        
        string(
            name: 'ANSIBLE_TAGS', 
            defaultValue: 'webserver', 
            description: 'Type tags explicitly here to force-override execution targets (e.g., webserver, apache, all)'
        )
        
        string(
            name: 'PLAYBOOK_PATH', 
            defaultValue: 'playbooks/site.yml', 
            description: 'Target playbook file path profile'
        )
    }

    environment {
        ANSIBLE_CONFIG = "${WORKSPACE}/deploy/ansible.cfg"
    }

    stages {
        stage('Initialise Workspace') {
            steps {
                echo "Executing securely on workspace branch: ${env.GIT_BRANCH}"
                echo "Target selection: ${params.inventory} environment using tags: ${params.ANSIBLE_TAGS}"
            }
        }

        stage('Prepare Ansible Configuration') {
            steps {
                echo "Dynamically injecting workspace target into ansible.cfg"
                sh 'sed -i "s|roles_path = .*|roles_path = ./roles:${WORKSPACE}/roles|g" ${WORKSPACE}/deploy/ansible.cfg'
            }
        }

        stage('Run Ansible playbook') {
            steps {
                echo "VICTORY TRACK RUN: Invoking Ansible playbook execution against the ${params.inventory} environment..."
                sshagent(['private-key']) {
                    sh '''
                        ansible-playbook \
                          -i ${WORKSPACE}/inventory/${inventory}.yml \
                          ${WORKSPACE}/${PLAYBOOK_PATH} \
                          --tags ${ANSIBLE_TAGS} \
                          --extra-vars "ansible_ssh_timeout=5 inventory=${inventory}" || true
                    '''
                }
            }
        }
    }
    
    post {
        always {
            echo 'Wiping workspace components post-execution...'
            cleanWs(cleanWhenAborted: true, cleanWhenFailure: true, deleteDirs: true)
        }
    }
}

        stage('SonarQube Quality Gate') {
        if (env.BRANCH_NAME =~ /^(develop|hotfix|release|main|master)/) {
            
            def scannerHome = tool 'SonarQubeScanner'
            
            withSonarQubeEnv('sonarqube') {
                sh "${scannerHome}/bin/sonar-scanner \
                -Dsonar.projectKey=php-todo \
                -Dsonar.projectName=php-todo \
                -Dsonar.host.url=http://54.91.224.40:9000 \
                -Dsonar.sources=. \
                -Dsonar.exclusions=**/vendor/**,**/tests/** \
                -Dsonar.php.exclusions=**/vendor/** \
                -Dsonar.php.coverage.reportPaths=build/logs/clover.xml \
                -Dsonar.php.tests.reportPath=build/logs/junit.xml"
            }
            
            timeout(time: 3, unit: 'MINUTES') {
                waitForQualityGate abortPipeline: true
            }
            
        } else {
            echo "Skipping Quality Gate check: Current branch [${env.BRANCH_NAME}] is a developer feature tier."
        }
    }
